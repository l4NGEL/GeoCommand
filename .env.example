# Bu dosyayı .env olarak kopyalayın ve parolayı değiştirin. .env git tarafından yok sayılır.
GEOCOMMAND_DB_NAME=geocommand
GEOCOMMAND_DB_USER=geocommand
GEOCOMMAND_DB_PASSWORD=degistir-beni
GEOCOMMAND_DB_PORT=5433

# API bağlantı dizesi (user-secrets yerine ortam değişkeni tercih edilirse):
# ConnectionStrings__GeoCommand=Host=localhost;Port=5433;Database=geocommand;Username=geocommand;Password=<parola>
