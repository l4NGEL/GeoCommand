<Application x:Class="GeoCommand.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GeoCommand.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <conv:TurkishTextConverter x:Key="Tr" />
        <conv:StatusBrushConverter x:Key="StatusBrush" />
        <conv:LocalTimeConverter x:Key="LocalTime" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <conv:BoolToVisibleConverter x:Key="BoolToVisible" />
        <conv:CoordinateConverter x:Key="Coord" />

        <SolidColorBrush x:Key="Chrome" Color="#1F2A37" />
        <SolidColorBrush x:Key="ChromeText" Color="#E8EDF2" />
        <SolidColorBrush x:Key="Panel" Color="#F5F7FA" />
        <SolidColorBrush x:Key="Border" Color="#D8DEE6" />
        <SolidColorBrush x:Key="Muted" Color="#5E6B7A" />
        <SolidColorBrush x:Key="Accent" Color="#2F6FD6" />

        <Style TargetType="TextBlock" x:Key="Header">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#1F2A37" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Application.Resources>
</Application>
