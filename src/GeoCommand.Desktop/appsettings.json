{
  "Api": {
    "BaseUrl": "http://localhost:5080"
  },
  "Map": {
    // false: çevrimdışı ortamda altlık harita indirilmez; araçlar, bölgeler ve iz vektör olarak çizilmeye devam eder.
    "UseOnlineTiles": true,
    // OpenStreetMap karo kullanım politikası uygulamayı tanımlayan bir User-Agent ister.
    "UserAgent": "GeoCommand-PortfolioDemo/1.0 (egitim amacli simulasyon)",
    "CenterLatitude": 39.915,
    "CenterLongitude": 32.845,
    "Resolution": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/GeoCommand/logs/desktop-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
