<Window x:Class="GeoCommand.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GeoCommand.Desktop.ViewModels"
        xmlns:views="clr-namespace:GeoCommand.Desktop.Views"
        xmlns:svc="clr-namespace:GeoCommand.Desktop.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="GeoCommand — Görev ve Olay Takip Simülasyonu"
        Width="1440" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Panel}" FontSize="12.5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk: başlık, bağlantı durumu, veri kaynağı -->
        <Border Grid.Row="0" Background="{StaticResource Chrome}" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GeoCommand" Foreground="{StaticResource ChromeText}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="  eğitim / portföy simülasyonu — gerçek sistemlere bağlı değildir" Foreground="#9FB0C2" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#9FB0C2" VerticalAlignment="Center" Margin="0,0,6,0"
                               Text="{Binding SourceStatus.SourceType, StringFormat=Kaynak: {0}, FallbackValue=Kaynak: —}" />
                    <ComboBox Width="170" Margin="0,0,6,0" ItemsSource="{Binding SourceStatus.AvailableScenarios}"
                              SelectedItem="{Binding SelectedScenario}" ToolTip="Senaryo / kayıt dosyası" />
                    <Button Content="▶ Başlat" Command="{Binding StartSourceCommand}" />
                    <Button Content="■ Durdur" Command="{Binding StopSourceCommand}" />
                    <Border Margin="10,0,0,0" Padding="10,3" CornerRadius="10" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#C0392B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Connected}">
                                        <Setter Property="Background" Value="#2E9E5B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Reconnecting}">
                                        <Setter Property="Background" Value="#D49A1F" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Connecting}">
                                        <Setter Property="Background" Value="#D49A1F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="● Bağlantı yok" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Connected}">
                                            <Setter Property="Text" Value="● Canlı" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Reconnecting}">
                                            <Setter Property="Text" Value="● Yeniden bağlanıyor" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LinkState}" Value="{x:Static svc:LinkState.Connecting}">
                                            <Setter Property="Text" Value="● Bağlanıyor" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bildirim bantları -->
        <StackPanel Grid.Row="1">
            <Border Background="#FDEDEC" BorderBrush="#E6B0AA" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding IsLinkDown, Converter={StaticResource BoolToVisible}}">
                <TextBlock Foreground="#922B21">
                    <Run Text="Canlı bağlantı yok — ekrandaki veriler güncel olmayabilir. " FontWeight="SemiBold" />
                    <Run Text="{Binding LinkMessage, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <Border Background="#FDEDEC" Padding="12,6" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Kapat" Command="{Binding DismissMessagesCommand}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#922B21" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border Background="#EAF2FB" Padding="12,6" Visibility="{Binding InfoMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Kapat" Command="{Binding DismissMessagesCommand}" />
                    <TextBlock Text="{Binding InfoMessage}" Foreground="#1B4F8C" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- Sol: araçlar ve bölgeler -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="Bölgeler" />
                        <ItemsControl ItemsSource="{Binding Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Sil" Padding="6,0" Margin="0" MinHeight="20"
                                                Command="{Binding DataContext.DeleteZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Henüz bölge yok." Foreground="{StaticResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Zones.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Araçlar" />
                        <ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" AutomationProperties.Name="Araç listesi">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VehicleItemViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}"
                                                           Text="{Binding LastUpdateUtc, Converter={StaticResource LocalTime}}" />
                                                <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Foreground="{StaticResource Muted}">
                                                <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource Tr}}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SpeedKmh, Mode=OneWay, StringFormat={}{0:0} km/sa}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Orta: harita + olay listesi -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="250" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="230" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <views:MapView x:Name="Map" />
                        <!-- Bölge çizim araç çubuğu -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8" Background="#EEFFFFFF"
                                CornerRadius="4" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <StackPanel>
                                <Button Content="＋ Yeni bölge çiz" Command="{Binding BeginZoneCommand}" Margin="0"
                                        Visibility="{Binding IsDrawingZone, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}" />
                                <StackPanel Visibility="{Binding IsDrawingZone, Converter={StaticResource BoolToVisible}}" Width="230">
                                    <TextBlock Text="Haritaya tıklayarak köşe ekleyin" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource Label}" Text="Bölge adı" />
                                    <TextBox Text="{Binding NewZoneName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                    <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,6"
                                               Text="{Binding DraftVertices.Count, StringFormat={}{0} köşe (en az 3)}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Kaydet" Command="{Binding SaveZoneCommand}" />
                                        <Button Content="Geri al" Command="{Binding UndoVertexCommand}" />
                                        <Button Content="Vazgeç" Command="{Binding CancelZoneCommand}" Margin="0" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Text="{Binding Events.Count, StringFormat={}{0} olay}" />
                            <TextBlock Style="{StaticResource Header}" Text="Olaylar (canlı)" />
                        </DockPanel>
                        <ListView ItemsSource="{Binding Events}" BorderThickness="0" AutomationProperties.Name="Olay listesi">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Zaman" Width="72"
                                                    DisplayMemberBinding="{Binding OccurredAtUtc, Converter={StaticResource LocalTime}}" />
                                    <GridViewColumn Header="Tür" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="4" Height="14" Margin="0,0,6,0" Fill="{Binding Type, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding Type, Converter={StaticResource Tr}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Araç" Width="80" DisplayMemberBinding="{Binding Callsign}" />
                                    <GridViewColumn Header="Açıklama" Width="460" DisplayMemberBinding="{Binding Message}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Sağ: seçili araç ayrıntıları -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <TextBlock Text="Ayrıntılar için listeden veya haritadan bir araç seçin." Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedVehicle}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DockPanel Visibility="{Binding SelectedVehicle, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Haritada göster" Command="{Binding FocusSelectedCommand}" Margin="0" />
                                <TextBlock Text="{Binding SelectedVehicle.Callsign}" FontSize="18" FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="Kimlik" />
                                <TextBox Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Text="{Binding SelectedVehicle.Id, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Durum" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding SelectedVehicle.Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding SelectedVehicle.Status, Converter={StaticResource Tr}}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Konum (WGS84)" />
                                <TextBlock Grid.Row="2" Grid.Column="1">
                                    <Run Text="{Binding SelectedVehicle.Latitude, Mode=OneWay, Converter={StaticResource Coord}}" /><Run Text=", " /><Run Text="{Binding SelectedVehicle.Longitude, Mode=OneWay, Converter={StaticResource Coord}}" />
                                </TextBlock>
                                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Hız" />
                                <TextBlock Grid.Row="3" Grid.Column="1">
                                    <Run Text="{Binding SelectedVehicle.SpeedMps, Mode=OneWay, StringFormat={}{0:0.0} m/s}" /><Run Text=" (" /><Run Text="{Binding SelectedVehicle.SpeedKmh, Mode=OneWay, StringFormat={}{0:0} km/sa}" /><Run Text=")" />
                                </TextBlock>
                                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Yön" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedVehicle.HeadingDegrees, StringFormat={}{0:0}°}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Son güncelleme" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedVehicle.LastUpdateUtc, Converter={StaticResource LocalTime}, ConverterParameter='dd.MM.yyyy HH:mm:ss'}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Aktif görev" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedVehicle.ActiveMissionId, TargetNullValue=Yok}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>

                        <TabControl>
                            <TabItem Header="Görevler">
                                <DockPanel Margin="4">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                                        <TextBlock Style="{StaticResource Label}" Text="Görev açıklaması" />
                                        <TextBox Text="{Binding MissionDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" />
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="Görev ata" Command="{Binding AssignMissionCommand}" Margin="6,0,0,0" />
                                            <TextBlock Style="{StaticResource Label}" Text="Öncelik" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding MissionPriority}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource Tr}}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Missions}" HorizontalContentAlignment="Stretch" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MissionItemViewModel}">
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Mission.Description}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <TextBlock Foreground="{StaticResource Muted}">
                                                            <Run Text="{Binding Mission.Priority, Mode=OneWay, Converter={StaticResource Tr}}" />
                                                            <Run Text=" öncelik · " />
                                                            <Run Text="{Binding Mission.Status, Mode=OneWay, Converter={StaticResource Tr}}" />
                                                            <Run Text=" · atanma " />
                                                            <Run Text="{Binding Mission.AssignedAtUtc, Mode=OneWay, Converter={StaticResource LocalTime}, ConverterParameter='dd.MM HH:mm:ss'}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Content="Başlat" Visibility="{Binding CanStart, Converter={StaticResource BoolToVisible}}"
                                                                    Command="{Binding DataContext.StartMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Content="Tamamla" Visibility="{Binding CanComplete, Converter={StaticResource BoolToVisible}}"
                                                                    Command="{Binding DataContext.CompleteMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Content="İptal" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisible}}"
                                                                    Command="{Binding DataContext.CancelMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Geçmiş">
                                <DockPanel Margin="4">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Başlangıç" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding HistoryFrom, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="gg.aa.yyyy ss:dd (yerel saat)" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Bitiş" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HistoryTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" ToolTip="gg.aa.yyyy ss:dd (yerel saat)" />
                                        </Grid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Sorgula" Command="{Binding QueryHistoryCommand}" FontWeight="SemiBold" />
                                            <Button Content="Son 5 dk" Command="{Binding QuickRangeCommand}" CommandParameter="5" />
                                            <Button Content="Son 1 sa" Command="{Binding QuickRangeCommand}" CommandParameter="60" />
                                            <Button Content="Temizle" Command="{Binding ClearHistoryCommand}" />
                                        </WrapPanel>
                                        <CheckBox Content="İzi haritada göster" IsChecked="{Binding ShowHistoryOnMap}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"
                                                   Visibility="{Binding HistorySummary, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <ListView ItemsSource="{Binding HistoryEvents}" BorderThickness="0">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Zaman" Width="80" DisplayMemberBinding="{Binding OccurredAtUtc, Converter={StaticResource LocalTime}}" />
                                                <GridViewColumn Header="Olay" Width="250" DisplayMemberBinding="{Binding Message}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Durum çubuğu -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Şimdi eşitle" Command="{Binding ResyncCommand}" Margin="0" Padding="8,0" MinHeight="20" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastSyncText}" Foreground="{StaticResource Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CursorPositionText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
